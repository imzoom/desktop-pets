<Window x:Class="DesktopPet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Pet - Character Studio"
        Width="256" Height="256"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        ResizeMode="NoResize"
        Focusable="True"
        WindowStartupLocation="Manual"
        MouseDown="Window_MouseDown"
        MouseLeftButtonUp="Window_MouseLeftButtonUp"
        MouseDoubleClick="Window_MouseDoubleClick">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="🥷 Switch to Hooded Blade (Sword Master)" Click="MenuCharHoodedBlade_Click" IsChecked="True" x:Name="MenuItemCharHoodedBlade" FontWeight="Bold" />
            <MenuItem Header="🤖 Switch to Robot Pet" Click="MenuCharRobot_Click" x:Name="MenuItemCharRobot" />
            <Separator />
            <MenuItem Header="⚡ Sword Power (Space / Click)" Click="MenuPower_Click" x:Name="MenuItemPower" FontWeight="Bold" />
            <MenuItem Header="🗡️ Sword Slash (A)" Click="MenuAttack_Click" x:Name="MenuItemAttack" />
            <MenuItem Header="🦘 Leap Jump (J)" Click="MenuJump_Click" x:Name="MenuItemJump" />
            <MenuItem Header="🏃 Run Sprint (R)" Click="MenuRun_Click" />
            <MenuItem Header="🧍 Idle Stance (I)" Click="MenuIdle_Click" />
            <Separator />
            <MenuItem Header="Autonomous Roaming &amp; Actions" IsCheckable="True" IsChecked="True" Click="MenuAutonomous_Click" x:Name="MenuItemAutonomous" FontWeight="Bold" />
            <MenuItem Header="Roaming Activity">
                <MenuItem Header="🌱 Chill &amp; Relaxed (Calm, rare running)" Click="MenuPaceCalm_Click" IsChecked="True" x:Name="MenuItemPaceCalm" />
                <MenuItem Header="⚡ Active (More frequent movement)" Click="MenuPaceActive_Click" x:Name="MenuItemPaceActive" />
                <MenuItem Header="🛑 Sit Still (No running)" Click="MenuPaceStill_Click" x:Name="MenuItemPaceStill" />
            </MenuItem>
            <Separator />
            <MenuItem Header="Frame Rate">
                <MenuItem Header="12 FPS (Half Speed)" Click="MenuFps12_Click" />
                <MenuItem Header="24 FPS (Default / Standard)" Click="MenuFps24_Click" IsChecked="True" x:Name="MenuItemFps24" />
                <MenuItem Header="30 FPS (Smooth)" Click="MenuFps30_Click" />
                <MenuItem Header="48 FPS (Double Speed)" Click="MenuFps48_Click" />
            </MenuItem>
            <MenuItem Header="Pet Scale">
                <MenuItem Header="Small (256x256)" Click="MenuScaleSmall_Click" IsChecked="True" x:Name="MenuItemScaleSmall" />
                <MenuItem Header="Medium (384x384)" Click="MenuScaleMedium_Click" x:Name="MenuItemScaleMedium" />
                <MenuItem Header="Original (512x512)" Click="MenuScaleOriginal_Click" x:Name="MenuItemScaleOriginal" />
            </MenuItem>
            <MenuItem Header="Always on Top" IsCheckable="True" IsChecked="True" Click="MenuTopmost_Click" x:Name="MenuItemTopmost" />
            <Separator />
            <MenuItem Header="📺 Send to Next Display (M)" Click="MenuNextScreen_Click" FontWeight="SemiBold" />
            <MenuItem Header="Reset to Screen Center" Click="MenuResetPos_Click" />
            <MenuItem Header="Exit Desktop Pet" Click="MenuExit_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <Grid Background="Transparent" x:Name="RootGrid" ToolTip="Desktop Pet: Double-click to switch character. Press 'M' to switch screens. Right-click for options.">
        <Image x:Name="PetImage"
               Stretch="Uniform"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality"
               RenderTransformOrigin="0.5, 0.5">
            <Image.RenderTransform>
                <ScaleTransform x:Name="PetScaleTransform" ScaleX="1" ScaleY="1" />
            </Image.RenderTransform>
        </Image>
    </Grid>
</Window>
